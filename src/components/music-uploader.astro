<music-uploader>
  <input type="file" accept="audio/*" multiple hidden />
  <button type="button" class="upload-button">
    <svg class="icon">
      <use href="/icons.svg#fa6-solid--plus"></use>
    </svg>
  </button>
</music-uploader>

<style>
  music-uploader {
    display: flex;
    justify-content: center;
  }

  .upload-button {
    display: inline-flex;
    padding: 0.35rem;
    block-size: 1.75rem;
    border-radius: 100vmax;
    border: none;
    color: inherit;
    cursor: pointer;
    background-color: #3a3a3a;
    max-inline-size: 43%;

    @media (hover: hover) {
      &:hover {
        filter: brightness(1.2);
      }
    }
  }
  :global(.mobile) .upload-button {
    background-color: #282828;
  }

  .icon {
    fill: currentColor;
    inline-size: 100%;
    block-size: 100%;
  }
</style>

<script>
  import { MusicUploaderElement } from "./music-uploader";

  if (!customElements.get("music-uploader")) {
    customElements.define("music-uploader", MusicUploaderElement);
  }
</script>

---
import Layout from "../layouts/Layout.astro";
import MusicPlayer from "../components/music-player.astro";
import MusicUploader from "../components/music-uploader.astro";
import MusicList from "../components/music-list.astro";
---

<Layout>
  <main>
    <div class="music-manager">
      <div class="music-manager-layout">
        <MusicUploader />
        <MusicList />
      </div>
    </div>
    <div class="music-player">
      <MusicPlayer />
    </div>
  </main>
</Layout>

<style>
  main {
    display: grid;
    grid-template-rows: 1fr auto;
    block-size: 100svh;
  }

  .music-manager {
    max-inline-size: 100svw;
    overflow-inline: hidden;
    overflow-block: auto;
    scrollbar-color: #050505 transparent;
    scrollbar-gutter: stable both-edges;
  }

  .music-manager-layout {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-inline: auto;
    inline-size: clamp(20rem, 100%, 30rem);
    padding-block-start: 1.25rem;
    padding-block-end: 0.75rem;
    padding-inline: 1.25rem;
  }

  .music-player {
    position: sticky;
    bottom: 0;
    scrollbar-color: #1b1b1b transparent;
    scrollbar-gutter: stable both-edges;
    margin-inline: auto;
    inline-size: clamp(20rem, 100%, 30rem);
    padding-block-end: 0.75rem;
    padding-inline: 0.5rem;
  }
</style>

<script>
  import { Music } from "../models/music";
  import { MusicSettingsStorage } from "../storage/music/settings";

  const uploader = document.querySelector("music-uploader")!;
  const list = document.querySelector("music-list")!;
  const player = document.querySelector("music-player")!;

  uploader.addEventListener("music-uploader:upload-files", async (e) => {
    await list.add(e.detail.files);
  });

  list.addEventListener("music-list:select", async (e) => {
    const { id, metadata, file } = e.detail.handle;

    let settings = MusicSettingsStorage.get(id);
    if (settings == null) {
      settings = Music.Settings.create();
      MusicSettingsStorage.set(id, settings);
    }

    try {
      const buffer = await file.arrayBuffer();
      await player.load(Music.create(id, metadata, settings, buffer));
    } catch (cause) {
      console.error(cause, id);
      alert("Sorry, failed to load the music file.\nThe file may have been moved or deleted.");
    }
  });

  player.addEventListener("music-player:start-loading", (e) => {
    list.startLoading(e.detail.id);
  });
  player.addEventListener("music-player:complete-loading", async (e) => {
    list.completeLoading(e.detail.id);
    await player.play();
  });
  player.addEventListener("music-player:fail-loading", (e) => {
    list.failLoading(e.detail.id);
  });
</script>

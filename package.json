{
  "name": "loop-nest",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && prettier --cache --check .",
    "build": "astro build",
    "preview": "firebase serve --project loop-nest",
    "deploy": "firebase deploy --project loop-nest"
  },
  "dependencies": {
    "music-metadata": "11.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.1"
  }
}
